---
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
---

<Layout title="關於 — Alvin Homelab" description="技術興趣、網站宗旨與聯絡方式。">
  <div class="page">
    <SectionTitle title="About" />
    <p class="empty">建置中</p>
  </div>
</Layout>

<style>
  .page{
    max-width: 880px;
    margin: 0 auto;
    padding: 48px 32px;
  }
  .empty{
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.9rem;
  }
</style>
