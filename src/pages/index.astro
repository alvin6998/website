---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OpenSourceCard from '../components/OpenSourceCard.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.sort(
  (a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()
);

const openSourcePicks = await getCollection('opensource');
---

<Layout>
  <section class="section">
    <SectionTitle title="Featured Projects" subtitle="自己動手做的東西。" />
    <div class="grid">
      {featuredProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          tech={project.data.tech}
          status={project.data.status}
          github={project.data.github}
          demo={project.data.demo}
        />
      ))}
    </div>
  </section>

  <section class="section">
    <SectionTitle title="Latest Technical Notes" subtitle="建置中。" />
  </section>

  <section class="section">
    <SectionTitle title="Open Source Picks" subtitle="推薦專案，非本人作品。" />
    {
      openSourcePicks.length > 0 ? (
        <div class="grid">
          {openSourcePicks.map(({ data }) => (
            <OpenSourceCard {...data} />
          ))}
        </div>
      ) : (
        <p class="empty">建置中。</p>
      )
    }
  </section>
</Layout>

<style>
  .section{
    max-width: 960px;
    margin: 0 auto;
    padding: 48px 32px;
  }
  .grid{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .empty{
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.9rem;
  }
</style>

