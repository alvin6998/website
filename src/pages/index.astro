---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import ProjectCard from '../components/ProjectCard.astro';
import OpenSourceCard from '../components/OpenSourceCard.astro';
import NoteCard from '../components/NoteCard.astro';

const allProjects = await getCollection('projects');
const featuredProjects = allProjects.sort(
  (a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf()
);

const openSourcePicks = await getCollection('opensource');

const allNotes = await getCollection('notes');
const latestNotes = allNotes
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf())
  .slice(0, 5);
 
const formatDate = (date: Date) => date.toISOString().slice(0, 10);
---


<Layout description="Homelab、SDR、氣象研究、開源推薦與技術筆記——一位熱愛技術的人整理專案與知識的地方。">
  <section class="section">
    <SectionTitle title="Featured Projects" subtitle="自己動手做的東西。" />
    <div class="grid">
      {featuredProjects.map((project) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          tech={project.data.tech}
          status={project.data.status}
          github={project.data.github}
          demo={project.data.demo}
        />
      ))}
    </div>
  </section>

    <section class="section">
    <SectionTitle title="Latest Technical Notes" subtitle="像知識庫，不是部落格。" />
    {
      latestNotes.length > 0 ? (
        <div class="list">
          {latestNotes.map((note) => (
            <NoteCard
              title={note.data.title}
              category={note.data.category}
              updatedAt={formatDate(note.data.updatedAt)}
              href={`/notes/${note.id}/`}
            />
          ))}
        </div>
      ) : (
        <p class="empty">建置中。</p>
      )
    }
  </section>


  <section class="section">
    <SectionTitle title="Open Source Picks" subtitle="推薦專案，非本人作品。" />
    {
      openSourcePicks.length > 0 ? (
        <div class="grid">
          {openSourcePicks.map(({ data }) => (
            <OpenSourceCard {...data} />
          ))}
        </div>
      ) : (
        <p class="empty">建置中。</p>
      )
    }
  </section>
</Layout>

<style>
  .section{
    max-width: 960px;
    margin: 0 auto;
    padding: 48px 32px;
  }
  .grid{
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .list{
    display: flex;
    flex-direction: column;
  }
  .empty{
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.9rem;
  }
</style>

