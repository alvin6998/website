---
import { getCollection } from 'astro:content';

import Layout from '../layouts/Layout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import OpenSourceCard from '../components/OpenSourceCard.astro';

const projects = await getCollection('opensource');
---

<Layout title="開源推薦 — Alvin Homelab">
  <div class="page">
    <SectionTitle
      title="Open Source Picks"
      subtitle="推薦專案，非本人作品。"
    />

    {
      projects.length > 0 ? (
        <div class="grid">
          {projects.map(({ data }) => (
            <OpenSourceCard {...data} />
          ))}
        </div>
      ) : (
        <p class="empty">目前尚未新增推薦專案。</p>
      )
    }
  </div>
</Layout>

<style>
  .page {
    max-width: 880px;
    margin: 0 auto;
    padding: 48px 32px;
  }

  .grid {
    display: grid;
    gap: 20px;
  }

  .empty {
    color: var(--text-dim);
    font-family: var(--mono);
    font-size: 0.9rem;
  }
</style>