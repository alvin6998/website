---
// OpenSourceCard.astro
import Button from './Button.astro';

interface Props {
  name: string;
  author: string;
  github: string;
  website?: string;
  license: string;
  language?: string[];
  category?:string;
  reason: string;
}

const { name, author, github, website, license,language = [],category, reason } = Astro.props;
---

<article class="card">
  <div class="card-head">
    <h3>{name}</h3>
    <span class="badge">推薦專案・非本人作品</span>
  </div>

  <div class="meta">
    {category && <span class="category">{category}</span>}

    {language.length > 0 && (
      <div class="tags">
        {language.map((lang) => (
          <span class="tag">{lang}</span>
      ))}
    </div>
  )}

  <p>原作者：{author} ・ License：{license}</p>
</div>

  <p class="reason">{reason}</p>

  <div class="links">
    <Button href={github} external>原始 GitHub</Button>
    {website && <Button href={website} external>官方網站</Button>}
  </div>
</article>

<style>
  .card{
    position: relative;
    overflow: hidden;
    background: rgba(22, 27, 34, 0.6);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px dashed rgba(255, 255, 255, 0.16);
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color .15s ease, background .15s ease;
  }
  .card::before{
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      500px circle at var(--mx, 50%) var(--my, 50%),
      rgba(210, 153, 34, 0.15),
      transparent 40%
    );
    opacity: 0;
    transition: opacity .3s ease;
    pointer-events: none;
  }
  .card:hover::before{
    opacity: 1;
  }
  .card:hover{
    background: rgba(22, 27, 34, 0.8);
    border-color: rgba(255, 255, 255, 0.28);
  }
  .card-head{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .card-head h3{
    font-size: 1rem;
    font-weight: 600;
  }
  .badge{
    font-family: var(--mono);
    font-size: 0.68rem;
    color: #d29922;
    background: rgba(210, 153, 34, 0.12);
    border: 1px solid rgba(210, 153, 34, 0.3);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .meta{
    display:flex;
    flex-direction:column;
    gap:8px;
    font-family:var(--mono);
    font-size:.78rem;
    color:var(--text-dim);
  }
  .reason{
    font-size: 0.88rem;
    color: var(--text);
    line-height: 1.6;
  }
  .links{
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }
  .category{
  display:inline-flex;
  align-self:flex-start;
  padding:3px 10px;
  border-radius:999px;
  background:rgba(56,139,253,.15);
  border:1px solid rgba(56,139,253,.35);
  color:#58a6ff;
  font-size:.72rem;
  }

  .tags{
    display:flex;
    flex-wrap:wrap;
    gap:8px;
  }

  .tag{
    padding:3px 10px;
    border-radius:999px;
    border:1px solid var(--border);
    font-size:.72rem;
    color:var(--text-dim);
  }
</style>