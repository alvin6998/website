---
// OpenSourceCard.astro
import Button from './Button.astro';

interface Props {
  name: string;
  author: string;
  github: string;
  website?: string;
  license: string;
  reason: string;
}

const { name, author, github, website, license, reason } = Astro.props;
---

<article class="card">
  <div class="card-head">
    <h3>{name}</h3>
    <span class="badge">推薦專案・非本人作品</span>
  </div>

  <p class="meta">原作者：{author} ・ License：{license}</p>

  <p class="reason">{reason}</p>

  <div class="links">
    <Button href={github} external>原始 GitHub</Button>
    {website && <Button href={website} external>官方網站</Button>}
  </div>
</article>

<style>
  .card{
    background: var(--bg-card);
    border: 1px dashed var(--border);
    border-radius: 8px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .card-head{
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .card-head h3{
    font-size: 1rem;
    font-weight: 600;
  }
  .badge{
    font-family: var(--mono);
    font-size: 0.68rem;
    color: #d29922;
    background: rgba(210, 153, 34, 0.12);
    border: 1px solid rgba(210, 153, 34, 0.3);
    padding: 2px 8px;
    border-radius: 999px;
    white-space: nowrap;
  }
  .meta{
    font-family: var(--mono);
    font-size: 0.78rem;
    color: var(--text-dim);
  }
  .reason{
    font-size: 0.88rem;
    color: var(--text);
    line-height: 1.6;
  }
  .links{
    display: flex;
    gap: 8px;
    margin-top: 4px;
  }
</style>
